		simple-audio-card,bitclock-inversion;
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,name = "rockchip,bt";
		phandle = <0x31f>;

		simple-audio-card,cpu {
			sound-dai = <0x140>;
		};

		simple-audio-card,codec {
			sound-dai = <0x141 0x01>;
		};
	};

	dc_12v: dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
		phandle = <0x149>;
	};

	leds: leds {
		compatible = "gpio-leds";
		phandle = <0x320>;

		/* 2026-11-05: pins taken from the vendor DTB. ophub had a single
		 * work_led on gpio0-15 (pin 15), which drives nothing on this
		 * board -- measured: toggling it lights no LED at all.
		 * gpio0-10 (pin 10) = red, gpio0-19 (pin 19) = blue (sys).
		 */
		power_led: power {
			gpios = <0x3d 0x0a 0x00>;
			default-state = "on";
			linux,default-trigger = "default-on";
		};

		work_led: work {
			gpios = <0x3d 0x13 0x00>;
			linux,default-trigger = "heartbeat";
			phandle = <0x321>;
		};
	};

	pdmics: dummy-codec {
		status = "disabled";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
		phandle = <0x143>;
	};

	pdm_mic_array: pdm-mic-array {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,pdm-mic-array";
		phandle = <0x322>;
		simple-audio-card,mclk-fs = <0x100>;

		simple-audio-card,dai-link@0 {
			format = "i2s";

			codec {
				sound-dai = <0x403>;
			};

			cpu {
				sound-dai = <0x404>;
			};
		};
	};

	rk809_sound: rk809-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-rk809";
		hp-det-gpio = <0x84 0x01 0x01>;
		rockchip,format = "i2s";
		rockchip,mclk-fs = <0x100>;
		rockchip,cpu = <0xd7>;
		rockchip,codec = <0x144>;
		pinctrl-names = "default";
		pinctrl-0 = <0x145>;
		phandle = <0x323>;
	};

	spdif-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,name = "ROCKCHIP,SPDIF";
		simple-audio-card,mclk-fs = <0x80>;

		simple-audio-card,cpu {
			sound-dai = <0x146>;
		};

		simple-audio-card,codec {
			sound-dai = <0x147>;
		};
	};

	spdif_out: spdif-out {
		status = "okay";
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0x00>;
		phandle = <0x147>;
	};

	vad_sound: vad-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,rk3568-vad";
		rockchip,cpu = <0xd7>;
		rockchip,codec = <0x144 0x148>;
		phandle = <0x324>;
	};

	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x149>;
		phandle = <0x41>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x149>;
		phandle = <0x3c>;
	};

	vcc5v0_usb: vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x149>;
		phandle = <0x14a>;
	};

	vcc5v0_host: vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		gpio = <0x3d 0x06 0x00>;
		vin-supply = <0x14a>;
		pinctrl-names = "default";
		pinctrl-0 = <0x14b>;
		phandle = <0x12d>;
	};

	vcc5v0_otg: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		/* 2026-11-05: without these two the regulator is never enabled
		 * (no consumer asks for it), so gpio0-5 stays low and the
		 * USB3 port has no VBUS at all. */
		regulator-boot-on;
		regulator-always-on;
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		/* 2026-11-05: pin 22 = GPIO0_C6 (vendor DTB). Was pin 5. */
		gpio = <0x3d 0x16 0x00>;
		vin-supply = <0x14a>;
		pinctrl-names = "default";
		pinctrl-0 = <0x14c>;
		phandle = <0x12e>;
	};

	vcc3v3_lcd0_n: vcc3v3-lcd0-n {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_lcd0_n";
		regulator-boot-on;
		gpio = <0x3d 0x17 0x00>;
		enable-active-high;
		phandle = <0x9b>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vcc3v3_lcd1_n: vcc3v3-lcd1-n {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_lcd1_n";
		regulator-boot-on;
		gpio = <0x3d 0x15 0x00>;
		enable-active-high;
		phandle = <0xa3>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x38 0x05>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <0x14e 0x402>;
		post-power-on-delay-ms = <0xc8>;
		reset-gpios = <0xc8 0x09 0x01>;
		phandle = <0xbf>;
		wifi_wl-gpios = <0x3d 0x09 0x00>;
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x39>;
		wifi_chip_type = "rk960";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0x14f>;
		WIFI,host_wake_irq = <0xc8 0x0a 0x00>;
		phandle = <0x325>;
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		bt_port = "/dev/ttyS1";
		clocks = <0x38 0x05>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0xc8 0x0d 0x01>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0x150>;
		pinctrl-1 = <0x151>;
		BT,reset_gpio = <0xc8 0x0f 0x00>;
		BT,wake_gpio = <0xc8 0x11 0x00>;
		BT,wake_host_irq = <0xc8 0x10 0x00>;
		status = "okay";
		phandle = <0x326>;
	};

	test-power {
		status = "okay";
	};

	vcc_camera: vcc-camera-regulator {
		compatible = "regulator-fixed";
		gpio = <0x3d 0x11 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x152>;
		regulator-name = "vcc_camera";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x327>;
	};

	vcc3v3_pcie: vcc3v3-pcie {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		enable-active-high;
		gpio = <0x3d 0x12 0x00>;
		startup-delay-us = <0x1388>;
		vin-supply = <0x149>;
		phandle = <0xb9>;
	};

	chosen: chosen {
		phandle = <0x328>;
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x02>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x01>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xfc 0x08>;
		pinctrl-names = "default";
		pinctrl-0 = <0x102>;
		status = "okay";
	};

	debug: debug@fd904000 {
		compatible = "rockchip,debug";
		reg = <0x00 0xfd904000 0x00 0x1000 0x00 0xfd905000 0x00 0x1000 0x00 0xfd906000 0x00 0x1000 0x00 0xfd907000 0x00 0x1000>;
		phandle = <0x329>;
	};

	cspmu: cspmu@fd90c000 {
		compatible = "rockchip,cspmu";
		reg = <0x00 0xfd90c000 0x00 0x1000 0x00 0xfd90d000 0x00 0x1000 0x00 0xfd90e000 0x00 0x1000 0x00 0xfd90f000 0x00 0x1000>;
		phandle = <0x32a>;
	};

