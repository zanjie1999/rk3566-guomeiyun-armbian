		touch {

			touch_gpio: touch-gpio {
				rockchip,pins = <0x00 0x0d 0x00 0x132 0x00 0x0e 0x00 0x130>;
				phandle = <0xdc>;
			};

			ts_int_active: ts_int_active {
				rockchip,pins = <0x00 0x0d 0x00 0x132>;
				phandle = <0xdd>;
			};

			ts_reset_active: ts_reset_active {
				rockchip,pins = <0x00 0x0e 0x00 0x132>;
				phandle = <0xde>;
			};

			ts_int_suspend: ts_int_suspend {
				rockchip,pins = <0x00 0x0d 0x00 0x139>;
				phandle = <0xdf>;
			};

			ts_reset_suspend: ts_reset_suspend {
				rockchip,pins = <0x00 0x0e 0x00 0x139>;
				phandle = <0xe0>;
			};
		};

		sdio-pwrseq {

			wifi_enable_h: wifi-enable-h {
				rockchip,pins = <0x02 0x09 0x00 0x130 0x00 0x08 0x00 0x130>;
				phandle = <0x14e>;
			};

			wifi-32k {
				rockchip,pins = <0x02 0x16 0x01 0x130>;
				phandle = <0x402>;
			};
		};

		usb {

			vcc5v0_host_en: vcc5v0-host-en {
				rockchip,pins = <0x00 0x06 0x00 0x130>;
				phandle = <0x14b>;
			};

			vcc5v0_otg_en: vcc5v0-otg-en {
				/* 2026-11-05: pin 22 = GPIO0_C6, matching the vendor
				 * DTB. ophub used pin 5 here, which is not wired to
				 * any VBUS switch on this board.
				 */
				rockchip,pins = <0x00 0x16 0x00 0x130>;
				phandle = <0x14c>;
			};
		};

		wireless-bluetooth {

			uart1_gpios: uart1-gpios {
