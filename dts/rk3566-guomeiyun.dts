			lcd-rst-gpio {
				rockchip,pins = <0x00 0x1d 0x00 0x130>;
				phandle = <0x401>;
			};
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <0x13a 0x00>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;
		phandle = <0x31d>;

		vol-up-key {
			label = "volume up";
			linux,code = <0x73>;
			press-threshold-microvolt = <0x6d6>;
		};

		vol-down-key {
			label = "volume down";
			linux,code = <0x72>;
			press-threshold-microvolt = <0x48a1c>;
		};

		menu-key {
			label = "menu";
			linux,code = <0x8b>;
			press-threshold-microvolt = <0xef420>;
		};

		back-key {
			label = "back";
			linux,code = <0x9e>;
			press-threshold-microvolt = <0x13eb9c>;
		};
	};

	audiopwmout_diff: audiopwmout-diff {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,audiopwmout-diff";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,bitclock-master = <0x13b>;
		simple-audio-card,frame-master = <0x13b>;
		phandle = <0x31e>;

		simple-audio-card,cpu {
			sound-dai = <0x13c>;
		};

		master: simple-audio-card,codec {
			sound-dai = <0x13d>;
			phandle = <0x13b>;
		};
	};

