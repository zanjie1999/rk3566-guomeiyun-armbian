/*
 * RK3566 国美云音箱（GM260200482）—— Armbian 实际启动用设备树
 *
 * 来源：Armbian ophub 6.1.157-rk35xx 镜像自带
 *       /boot/dtb/rockchip/rk3566-wxy-oec-turbo-4g.dtb 反编译
 *       （firmware/rk3566-wxy-oec-turbo-4g.dtb 是未改动的原件，181827 字节）
 *
 * 已完成并在真机验证的改动（见 tools/patch-dt.py、tools/patch-gmac.py）：
 *   1. drm-logo@0  reg 归零  -> 修花屏（VOP 首帧读无效 IOVA 导致 IOMMU page fault）
 *   2. wifi_enable_h 等节点 rockchip,pins 的 0xff -> 0x130
 *      （0xff 是引脚组不是 pinconf，导致 pinctrl 注册失败）
 *   3. mmc@fe2c0000 删除 sd-uhs-sdr104  -> SDIO 无 1.8V 信令，SDR104 tuning 永远失败
 *   4. multi-dais / cs4333-codec 的 #sound-dai-cells 空值 -> <0x00>
 *   5. 新增 spk-amp（regulator-fixed）拉高功放使能 gpio1 RK_PA6 = gpio-38
 *      （主线 rockchip,dummy-codec 不解析厂商私有的 spk-ctl-gpios）
 *   6. gmac1 从 RGMII/m1 改回原厂 RMII/m0 + gpio4 RK_PB2 复位 + 50MHz 外部时钟
 *      -> PHY (RTL8201F) 能被识别；DMA 仍报 Failed to reset the dma，待解
 *
 * 注意：这是 dtc 反编译产物，phandle 是数字而非标签，可读性差但能直接编译。
 *       原厂（另一块板）设备树留作硬件参考：dts/reference/rk3566-speaker-vendor.dts
 */

/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "rockchip,rk3566-evb2-lp4x-v10", "rockchip,rk3566";
	model = "Rockchip RK3566 EVB2 LP4X V10 Board";

