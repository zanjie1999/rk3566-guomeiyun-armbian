		ts_reset_active = "/pinctrl/touch/ts_reset_active";
		ts_int_suspend = "/pinctrl/touch/ts_int_suspend";
		ts_reset_suspend = "/pinctrl/touch/ts_reset_suspend";
		wifi_enable_h = "/pinctrl/sdio-pwrseq/wifi-enable-h";
		vcc5v0_host_en = "/pinctrl/usb/vcc5v0-host-en";
		vcc5v0_otg_en = "/pinctrl/usb/vcc5v0-otg-en";
		uart1_gpios = "/pinctrl/wireless-bluetooth/uart1-gpios";
		wifi_host_wake_irq = "/pinctrl/wireless-wlan/wifi-host-wake-irq";
		lcd0_rst_gpio = "/pinctrl/lcd0/lcd0-rst-gpio";
		lcd1_rst_gpio = "/pinctrl/lcd1/lcd1-rst-gpio";
		adc_keys = "/adc-keys";
		audiopwmout_diff = "/audiopwmout-diff";
		master = "/audiopwmout-diff/simple-audio-card,codec";
		backlight = "/backlight";
		backlight1 = "/backlight1";
		bt_sco = "/bt-sco";
		bt_sound = "/bt-sound";
		dc_12v = "/dc-12v";
		leds = "/leds";
		work_led = "/leds/work";
		pdmics = "/dummy-codec";
		pdm_mic_array = "/pdm-mic-array";
		rk809_sound = "/rk809-sound";
		spdif_out = "/spdif-out";
		vad_sound = "/vad-sound";
		vcc3v3_sys = "/vcc3v3-sys";
		vcc5v0_sys = "/vcc5v0-sys";
		vcc5v0_usb = "/vcc5v0-usb";
		vcc5v0_host = "/vcc5v0-host-regulator";
		vcc5v0_otg = "/vcc5v0-otg-regulator";
		vcc3v3_lcd0_n = "/vcc3v3-lcd0-n";
		vcc3v3_lcd1_n = "/vcc3v3-lcd1-n";
		sdio_pwrseq = "/sdio-pwrseq";
		wireless_wlan = "/wireless-wlan";
		wireless_bluetooth = "/wireless-bluetooth";
		vcc_camera = "/vcc-camera-regulator";
		vcc3v3_pcie = "/vcc3v3-pcie";
		chosen = "/chosen";
		debug = "/debug@fd904000";
		cspmu = "/cspmu@fd90c000";
	};

	cs4333-codec {
		#sound-dai-cells = <0x00>;
		assigned-clock-parents = <0x27 0x48 0x27 0x48>;
		assigned-clock-rates = <0xbb8000>;
		assigned-clocks = <0x27 0x1a3 0x27 0x1a6>;
		clock-names = "mclk";
		clocks = <0x27 0x1a3>;
		compatible = "rockchip,dummy-codec";
		phandle = <0x403>;
		pinctrl-0 = <0x42>;
		pinctrl-names = "default";
		spk-ctl-gpios = <0xb8 0x06 0x00>;
		status = "okay";
	};

	multi-dais {
		#sound-dai-cells = <0x00>;
		capture,channel-mapping = <0x02 0x02>;
		compatible = "rockchip,multi-dais";
		dais = <0x142 0xd7>;
		phandle = <0x404>;
		playback,channel-mapping = <0x00 0x02>;
		status = "okay";
	};
	spk_amp: spk-amp {
		compatible = "regulator-fixed";
		regulator-name = "spk-amp-en";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		gpio = <0xb8 0x06 0x00>;
	};
};
